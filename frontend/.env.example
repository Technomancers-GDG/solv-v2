# Frontend Environment Configuration
# Copy this to .env.local and fill in actual values for each environment

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_MAP_VIEW=true
VITE_ENABLE_I18N=true
VITE_ENABLE_TESTING=false

# Environment
VITE_ENVIRONMENT=development
VITE_APP_NAME=Solv Supply Chain Coordination
VITE_APP_VERSION=1.0.0

# Performance
VITE_POLLING_INTERVAL_MS=12000
VITE_WS_RECONNECT_DELAY_MS=3000
VITE_WS_MAX_RETRIES=5

# Accessibility
VITE_HIGH_CONTRAST_MODE=false
VITE_REDUCE_MOTION=false

# Firebase Authentication (Admin Portal)
VITE_FIREBASE_API_KEY=AIzaSyA6h9eTkF_Fbn7ujGXvCw5VSCuLVJu5dFA
VITE_FIREBASE_AUTH_DOMAIN=lohin-8fddc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lohin-8fddc
VITE_FIREBASE_STORAGE_BUCKET=lohin-8fddc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=878789792698
VITE_FIREBASE_APP_ID=1:878789792698:web:11cb58a22a6bfbd197c383

# Google Fonts (optional override)
