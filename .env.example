# Database URL (defaults to local SQLite if left empty)
DATABASE_URL=sqlite:///./supply_chain.db

# Google Gemini API Key for AI decisions and disruption analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (optional fallback)
GROQ_API_KEY=your_groq_api_key_here

# Simulation Settings
SIMULATION_SPEED=180.0
DEMO_DISRUPTION_DELAY_SECONDS=4
ROUTE_USE_OSRM=false

# Firebase Admin SDK credentials path (optional)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
