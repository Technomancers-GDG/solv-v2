        startTransition(() => {
          setDashboard(d);
          setFacilities(f);
          setVehicles(v);
          setObjectives(o);
          setRoutes(r);
          setRecommendations(rec);
          setEvents(e);
          setError("");
        });
      } else {
        const [
          d, f, v, dr, o, r, s, rec, m, e, rf, inv, pd, ai
        ] = await Promise.all([
          apiFetch("/api/dashboard"),
          apiFetch("/api/facilities"),
          apiFetch("/api/vehicles"),
          apiFetch("/api/drivers"),
          apiFetch("/api/objectives"),
