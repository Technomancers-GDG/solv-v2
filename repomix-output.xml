    api_key_prefix = api_key[:8]

    client = IntegrationClient(
        name="Demo Client",
        api_key_hash=api_key_hash,
        api_key_prefix=api_key_prefix,
        contact_email="demo@example.com",
        rate_limit_per_minute=5000,
        enabled=True,
    )
    session.add(client)
    session.commit()

    print("=" * 60)
