<file path="frontend/src/styles.css">
:root {
  --bg: #ffffff;
  --panel: #ffffff;
  --panel-strong: #f3f3f3;
  --border: #191a23;
  --text: #191a23;
  --muted: #4e4e4e;
  --accent: #b9ff66;
  --teal: #b9ff66;
  --coral: #191a23;
  --steel: #f3f3f3;
  --danger: #ff5b5b;
  --shadow: 0 10px 24px rgba(25, 26, 35, 0.14);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "Space Grotesk", "Inter", sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at 0% 0%, rgba(185, 255, 102, 0.18), transparent 42%),
    radial-gradient(circle at 100% 100%, rgba(25, 26, 35, 0.08), transparent 46%),
    var(--bg);
  min-height: 100vh;
}

button,
input,
select {
  font: inherit;
}

button {
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 0.85rem 1.4rem;
  background: #191a23;
  color: #ffffff;
  cursor: pointer;
  transition: transform 180ms ease, box-shadow 180ms ease;
  box-shadow: none;
  font-weight: 500;
}

button:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 0 0 #191a23;
  background: #ffffff;
  color: #191a23;
}

button.danger {
  background: var(--danger);
  color: #ffffff;
}

.ambient-grid {
  display: none;
}

.hero,
.topline,
.tabs,
.view-stack {
  position: relative;
  z-index: 1;
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: flex-start;
  padding: 34px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: linear-gradient(145deg, #ffffff 0%, var(--panel-strong) 100%);
  box-shadow: var(--shadow);
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--accent);
  margin: 0 0 10px;
  font-size: 0.82rem;
}

.hero h1 {
  font-family: "Georgia", "Cambria", serif;
  font-size: clamp(2.2rem, 3vw, 3.6rem);
  margin: 0 0 14px;
  max-width: 720px;
}

.hero-copy {
  margin: 0;
  max-width: 760px;
  color: var(--muted);
  line-height: 1.7;
}

.hero-controls {
  display: grid;
  gap: 10px;
  min-width: 180px;
}

.topline {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin: 18px 0 18px;
}

.status-pill,
.metric-card,
.panel,
.banner,
.loading {
  border: 1px solid var(--border);
  background: var(--panel);
  box-shadow: var(--shadow);
  border-radius: 20px;
}

.status-pill {
  padding: 14px 16px;
}

.status-pill span {
  display: block;
  color: var(--muted);
  font-size: 0.84rem;
  margin-bottom: 4px;
  font-weight: 600;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 18px;
}

.tab {
  background: #ffffff;
  color: var(--text);
  border: 1px solid var(--border);
  box-shadow: none;
  font-weight: 500;
  border-radius: 14px;
  padding: 0.6rem 1.2rem;
}

.tab.active {
  background: var(--accent);
  color: #191a23;
  box-shadow: 0 3px 0 0 #191a23;
  transform: translateY(-2px);
}

.banner {
  margin: 0 0 16px;
  padding: 14px 16px;
  border-radius: 14px;
  font-weight: 500;
}

.banner.success {
  background: var(--accent);
  color: #191a23;
}

.banner.error {
  background: var(--danger);
