      recommendations={recommendations}
      setRecommendations={setRecommendations}
      wsSnapshot={wsSnapshot}
      message={message}
      error={error}
      setMessage={setMessage}
      setError={(msg) => {
        setError(msg);
        clearBanners();
      }}
    />
  );
}

export default function App() {
  return (
    <BrowserRouter>
      <Routes>
        <Route path="/*" element={<AppShell />} />
      </Routes>
    </BrowserRouter>
  );
}
