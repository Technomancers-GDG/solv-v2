  display: grid;
  gap: 14px;
}

.reroute-proposal h3 {
  font-size: 1rem;
  font-weight: 600;
}

.proposal-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.proposal-grid div {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 10px;
  background: var(--panel-strong);
  display: grid;
  gap: 4px;
}

.proposal-grid .label {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
}

.proposal-grid strong {
  font-size: 0.9rem;
}

.proposal-explanation {
  color: var(--text-secondary);
  font-size: 0.9rem;
  line-height: 1.5;
}

.proposal-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

@media (max-width: 480px) {
  .proposal-actions {
    flex-direction: column;
  }

  .proposal-actions button {
    width: 100%;
  }
}

/* ===== Instructions ===== */
.instructions-stack {
  display: grid;
  gap: 10px;
}

.instruction-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--panel);
  padding: 14px;
  display: grid;
  gap: 8px;
}

.instruction-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.instruction-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.instruction-meta strong {
  font-size: 0.9rem;
}

.instruction-action-label {
  color: var(--text-secondary);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: var(--panel-strong);
  padding: 2px 8px;
  border-radius: 999px;
}

.instruction-time {
  color: var(--muted);
  font-size: 0.78rem;
  white-space: nowrap;
}

.instruction-text {
  color: var(--text-secondary);
  font-size: 0.9rem;
  line-height: 1.5;
}

.instruction-actions {
  display: flex;
  gap: 10px;
  padding-top: 4px;
}

@media (max-width: 480px) {
  .instruction-actions {
    flex-direction: column;
  }

  .instruction-actions button {
    width: 100%;
  }
}

/* ===== Incident Form ===== */
.incident-form {
  display: grid;
  gap: 14px;
}

.incident-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

@media (max-width: 480px) {
  .incident-form-grid {
    grid-template-columns: 1fr;
  }
}

.incident-form .action-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

@media (max-width: 480px) {
  .incident-form .action-row {
    flex-direction: column;
  }

  .incident-form .action-row button {
    width: 100%;
  }
}

/* ===== Empty / States ===== */
.empty {
  color: var(--muted);
  font-size: 0.9rem;
  padding: 16px 0;
  text-align: center;
}

.loading-skeleton {
  background: linear-gradient(90deg, var(--panel-strong) 25%, var(--panel) 50%, var(--panel-strong) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.2s ease-in-out infinite;
  border-radius: var(--radius-md);
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.skeleton-card {
  height: 60px;
}

.skeleton-map {
  height: clamp(280px, 40vh, 420px);
}

.skeleton-text {
  height: 16px;
  width: 60%;
  margin-bottom: 8px;
}

.skeleton-text.short {
  width: 35%;
}
