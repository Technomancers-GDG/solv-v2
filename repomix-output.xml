}

.lp-trust-card .lp-h3 {
  font-size: 1rem;
  margin-bottom: 12px;
}

.lp-trust-card .lp-body {
  font-size: 0.9rem;
}

/* === CTA Section === */
.lp-cta {
  padding: 120px 0;
  position: relative;
  overflow: hidden;
}

.lp-cta-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 60% 40% at 50% 50%, rgba(185, 255, 102, 0.06) 0%, transparent 60%);
  z-index: 0;
}

.lp-cta-content {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 640px;
  margin: 0 auto;
}

.lp-cta-content .lp-h2 {
  margin-bottom: 20px;
}

.lp-cta-content .lp-body-lg {
  margin-bottom: 40px;
}

.lp-cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  justify-content: center;
}

.lp-cta-note {
  margin-top: 24px;
  font-size: 0.82rem;
  color: var(--lp-muted);
}

/* === Footer === */
.lp-footer {
  border-top: 1px solid var(--lp-border);
  padding: 48px 0 32px;
}

.lp-footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 48px;
  margin-bottom: 48px;
}

.lp-footer-brand .lp-body {
  font-size: 0.88rem;
  margin-top: 12px;
  max-width: 320px;
}

.lp-footer h4 {
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--lp-muted);
  margin: 0 0 16px;
  font-weight: 600;
}

.lp-footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 10px;
}

.lp-footer-links a {
  color: var(--lp-text);
  text-decoration: none;
  font-size: 0.9rem;
  transition: color 0.2s;
}

.lp-footer-links a:hover {
  color: var(--lp-accent);
}

.lp-footer-bottom {
  padding-top: 24px;
  border-top: 1px solid var(--lp-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.82rem;
  color: var(--lp-muted);
}

/* === Mobile Nav === */
.lp-nav-hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 4px;
  box-shadow: none;
}

.lp-nav-hamburger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--lp-text);
  border-radius: 2px;
  transition: all 0.3s ease;
}

.lp-nav-hamburger.open span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.lp-nav-hamburger.open span:nth-child(2) {
  opacity: 0;
}

.lp-nav-hamburger.open span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

.lp-nav-actions-mobile {
  display: none;
}

@media (max-width: 768px) {
  .lp-nav-hamburger {
    display: flex;
  }

  .lp-nav-actions {
    display: none;
  }

  .lp-nav-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(8, 9, 12, 0.98);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--lp-border);
    flex-direction: column;
    gap: 0;
    padding: 16px 24px;
  }

  .lp-nav-links.open {
    display: flex;
  }

  .lp-nav-link {
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    width: 100%;
    text-align: left;
  }

  .lp-nav-actions-mobile {
    display: flex;
    gap: 12px;
    padding-top: 16px;
  }

  .lp-nav-actions-mobile .lp-btn,
  .lp-nav-actions-mobile .lp-nav-link-secondary {
    flex: 1;
    text-align: center;
  }
}

/* === Divider === */
.lp-divider {
  width: 100%;
  height: 1px;
  background: var(--lp-border);
  margin: 0;
  border: none;
}

/* === Animations === */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(24px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.lp-animate {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}

.lp-animate.visible {
  opacity: 1;
  transform: translateY(0);
}

/* === Responsive === */
@media (max-width: 1024px) {
  .lp-hero-content {
    grid-template-columns: 1fr;
    gap: 48px;
    text-align: center;
  }

  .lp-hero-text .lp-body-lg {
    margin-left: auto;
    margin-right: auto;
  }

  .lp-hero-actions {
    justify-content: center;
  }

  .lp-hero-visual {
    display: none;
  }

  .lp-hero-stats {
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .lp-preview-content {
    grid-template-columns: 1fr;
  }

  .lp-footer-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 768px) {
  .lp-section {
    padding: 64px 0;
  }

  .lp-problem-grid,
  .lp-fails-grid,
  .lp-steps,
  .lp-trust-grid {
    grid-template-columns: 1fr;
  }

  .lp-outcomes-grid {
    grid-template-columns: 1fr;
  }

  .lp-hero {
    min-height: auto;
    padding: 120px 0 0;
  }

  .lp-hero-stats {
    grid-template-columns: 1fr;
    gap: 16px;
    text-align: center;
  }

  .lp-hero-stat h3 {
    font-size: 1.4rem;
  }

  .lp-nav-links {
    display: none;
  }

  .lp-footer-grid {
    grid-template-columns: 1fr;
  }
}
