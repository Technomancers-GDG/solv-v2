}

.loading {
  padding: 18px;
  border-radius: 18px;
}

.view-stack {
  display: grid;
  gap: 18px;
}

.grid-two {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.ops-layout,
.lane-stack,
.event-stack {
  display: grid;
  gap: 18px;
}

.metrics-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.metrics-row.single-column {
