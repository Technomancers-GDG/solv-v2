def test_mode_switch_and_time_window_penalties_are_applied_to_segments() -> None:
    graph = LogisticsGraph(
        nodes=[
            LogisticsNodeInput(id="a", name="A", node_type="warehouse"),
            LogisticsNodeInput(id="b", name="B", node_type="railhead"),
