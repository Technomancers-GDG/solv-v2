          setEvents(e);
          setRiskForecast(rf);
          setInventoryForecast(inv);
          setProactiveDispatches(pd);
          setAiActivity(ai);
          setError("");
        });
      }
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }, [clientContext]);

  useEffect(() => {
    refreshAll(true);
    const id = setInterval(() => refreshAll(false), 15000);
